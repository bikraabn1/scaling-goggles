# ==============================================================================
# NGABSENNN - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# App Security (Single-User Gate)
# ------------------------------------------------------------------------------
# Password for logging in to the ngabsennn dashboard
APP_PASSWORD=your_dashboard_password_here

# Secret key (at least 32 characters) for signing session cookies
SESSION_SECRET=replace_with_a_long_random_secret_string_minimum_32_chars

# ------------------------------------------------------------------------------
# GitLab Configuration
# ------------------------------------------------------------------------------
# Base URL of your GitLab instance (public gitlab.com or self-hosted, without trailing slash)
GITLAB_BASE_URL=https://gitlab.example.com

# Target Project ID in GitLab (found in repo settings/overview)
GITLAB_PROJECT_ID=123456

# Personal Access Token with minimal scope: `read_api` or `read_repository`
GITLAB_TOKEN=glpat-your_personal_access_token_here

# Optional author filter to fetch only your commits in shared repositories
# Matches against either GitLab author display name or commit email
GITLAB_AUTHOR_NAME=your_gitlab_username

# ------------------------------------------------------------------------------
# LLM API Configuration (OpenAI-compatible endpoints: Gemini, Groq, OpenRouter, etc.)
# ------------------------------------------------------------------------------
# Example 1: Google Gemini (Free tier available via OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIzaSy_your_gemini_api_key
# LLM_MODEL=gemini-1.5-flash

# Example 2: OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your_openrouter_api_key
LLM_MODEL=google/gemini-2.0-flash-001

# Example 3: Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key
# LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Monev MagangHub Kemnaker (Optional Auto-Submit)
# ------------------------------------------------------------------------------
# Active Bearer Token from MagangHub (obtained from Authorization header)
MONEV_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzUxMiJ9...

# Office coordinates for attendance check-in
MONEV_LATITUDE=-7.565374884700425
MONEV_LONGITUDE=110.81394969592333

